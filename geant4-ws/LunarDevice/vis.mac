# Macro file for the visualization setting in the initialization phase 
# of the B1 example when running in interactive mode
#

# Hide the vacuum volumes before a viewer exists.
/vis/verbose errors
/vis/geometry/set/visibility World 0 false
/vis/geometry/set/visibility Cavity 0 false

# Open the interactive TSG viewer once and defer refresh during scene setup.
/vis/open TSG_QT_GLES
/vis/viewer/set/autoRefresh false
# Draw geometry:
/vis/drawVolume
#
# Specify view angle:
/vis/viewer/set/viewpointVector -1 0 0
/vis/viewer/set/lightsVector -1 0 0
#
# Specify style (surface, wireframe, auxiliary edges,...)
/vis/viewer/set/style wireframe
/vis/viewer/set/auxiliaryEdge true
/vis/viewer/set/lineSegmentsPerCircle 100
#
# To superimpose all of the events from a given run:
/vis/scene/endOfEventAction accumulate 100
#
# Decorations
# Name
/vis/set/textColour green
/vis/set/textLayout right
/vis/scene/add/text2D 0.9 -.9 24 ! ! lunar_device
# or, if your system does not support right-adjustment
#/vis/scene/add/text2D 0 -.9 24 ! ! lunar_device
/vis/set/textLayout    # Revert to normal (left adjusted) layout
/vis/set/textColour    # Revert to default text colour (blue)
#
# Axes, scale, etc.
/vis/scene/add/scale   # Simple scale line
/vis/scene/add/axes    # Simple axes: x=red, y=green, z=blue.
/vis/scene/add/eventID # Drawn at end of event
/vis/scene/add/date    # Date stamp
/vis/scene/add/logo2D  # Simple logo
/vis/scene/add/logo    # 3D logo
#
# Frame
/vis/set/colour red
/vis/set/lineWidth 2
/vis/scene/add/frame   # Simple frame around the view
/vis/set/colour        # Revert to default colour (white)
/vis/set/lineWidth     # Revert to default line width (1.)
#
/vis/viewer/set/style surface
/vis/viewer/set/hiddenMarker true
/vis/viewer/set/viewpointThetaPhi 120 150
#
